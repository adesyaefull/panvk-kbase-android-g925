From: panvk-kbase-android worker <panvk-worker@localhost>
Subject: [PATCH android 019] use PanVK queue submission for Kbase release sync

Kbase resolves queue semaphore waits and signals in its CPU submission path.
Do not route Android release-image synchronization through DRM syncobj payload
copying on Kbase; let vkQueueSubmit2 use the Kbase-aware queue path instead.
Dependencies: 018-android-release-sync-payload-trace.patch.
Validation: Android arm64/API 35 ICD compile/link and focused source regression
test; G925 runtime retest required.

diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -753,6 +753,9 @@
    device->vk.shader_ops = &panvk_per_arch(device_shader_ops);
    device->vk.check_status = panvk_device_check_status;
    device->vk.get_timestamp = panvk_device_get_timestamp;
+#ifdef HAVE_PAN_KMOD_KBASE
+   if (!physical_device->kbase_node_path[0])
+#endif
       device->vk.copy_sync_payloads = vk_drm_syncobj_copy_payloads;
 #if PAN_ARCH >= 10
    device->vk.write_buffer_cp = panvk_write_buffer_cp;
