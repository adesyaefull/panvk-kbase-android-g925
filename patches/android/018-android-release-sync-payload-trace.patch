+                   "failed (%d)", i, wait_semaphore_count, result);
          goto fail;
       }
 
@@ -753,6 +755,8 @@
       struct vk_sync_timeline_point *signal_point = NULL;
       VkResult result = vk_sync_signal_unwrap(device, &signal, &signal_point);
