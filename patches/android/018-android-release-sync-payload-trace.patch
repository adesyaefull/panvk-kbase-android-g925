From: panvk-kbase-android worker <panvk-worker@localhost>
Subject: [PATCH android 018] trace Android release sync payload copy failures

Purpose: Distinguish the semaphore payload-copy path from QueueSubmit2 and
log the exact vk_device and DRM syncobj operation that fails, including errno.
Dependencies: 017-android-release-sync-logcat.patch.
Validation: Android arm64/API 35 ICD compile/link; device runtime retest required.

diff --git a/src/vulkan/runtime/vk_android.c b/src/vulkan/runtime/vk_android.c
--- a/src/vulkan/runtime/vk_android.c
+++ b/src/vulkan/runtime/vk_android.c
@@ -665,10 +665,10 @@
    }
    STACK_ARRAY_FINISH(wait_infos);
    if (result != VK_SUCCESS) {
-      mesa_loge("vkQueueSignalReleaseImageANDROID: QueueSubmit2 "
+      mesa_loge("vkQueueSignalReleaseImageANDROID: semaphore payload copy "
                 "failed (%d)", result);
       return vk_errorf(device, result,
-                       "vkQueueSignalReleaseImageANDROID: QueueSubmit2 failed");
+                       "vkQueueSignalReleaseImageANDROID: semaphore payload copy failed");
    }
 
    const VkSemaphoreGetFdInfoKHR get_fd = {
