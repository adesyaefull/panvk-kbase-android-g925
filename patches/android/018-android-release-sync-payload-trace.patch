       /* Nothing to wait on.  Just signal everything */
       result = vk_sync_signal_many(device, signal_count, signals);
       if (result != VK_SUCCESS) {
+         mesa_loge("vk_device_copy_semaphore_payloads: signal_many "
+                   "(signals=%u) failed (%d)", signal_count, result);
          goto fail;
       }
    } else if (signal_count > 0) {
@@ -793,6 +801,8 @@
       result = vk_sync_wait_many(device, wait_count, waits,
                                  VK_SYNC_WAIT_PENDING, UINT64_MAX);
       if (result != VK_SUCCESS) {
+         mesa_loge("vk_device_copy_semaphore_payloads: wait_many "
+                   "(waits=%u) failed (%d)", wait_count, result);
          goto fail;
       }
 
@@ -800,6 +810,9 @@
       result = device->copy_sync_payloads(device, wait_count, waits,
                                           signal_count, signals);
       if (result != VK_SUCCESS) {
+         mesa_loge("vk_device_copy_semaphore_payloads: copy_sync_payloads "
+                   "(waits=%u signals=%u) failed (%d)",
+                   wait_count, signal_count, result);
          goto fail;
       }
    }
@@ -821,6 +834,8 @@
    if (reset_count > 0) {
       result = vk_sync_reset_many(device, reset_count, resets);
       if (result != VK_SUCCESS) {
+         mesa_loge("vk_device_copy_semaphore_payloads: reset_many "
+                   "(resets=%u) failed (%d)", reset_count, result);
          goto fail;
       }
    }
