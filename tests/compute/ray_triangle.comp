#version 450

layout(local_size_x = 1) in;

layout(set = 0, binding = 0, std430) buffer Results {
   uint hit[];
} results;

bool
intersect_triangle(vec3 origin, vec3 direction)
{
   const vec3 v0 = vec3(0.0, 0.0, 0.0);
   const vec3 e1 = vec3(1.0, 0.0, 0.0);
   const vec3 e2 = vec3(0.0, 1.0, 0.0);
   const float epsilon = 1e-6;

   vec3 p = cross(direction, e2);
   float determinant = dot(e1, p);
   if (abs(determinant) < epsilon)
      return false;

   float inverse_determinant = 1.0 / determinant;
   vec3 t = origin - v0;
   float u = dot(t, p) * inverse_determinant;
   if (u < 0.0 || u > 1.0)
      return false;

   vec3 q = cross(t, e1);
   float v = dot(direction, q) * inverse_determinant;
   if (v < 0.0 || u + v > 1.0)
      return false;

   float distance = dot(e2, q) * inverse_determinant;
   return distance > epsilon;
}

void
main()
{
   uint ray = gl_GlobalInvocationID.x;
   vec3 origins[4] = vec3[](
      vec3(0.2, 0.2, -1.0),
      vec3(1.1, 1.1, -1.0),
      vec3(0.0, 0.0, -1.0),
      vec3(0.2, 0.2, -1.0)
   );
   vec3 directions[4] = vec3[](
      vec3(0.0, 0.0, 1.0),
      vec3(0.0, 0.0, 1.0),
      vec3(0.0, 0.0, 1.0),
      vec3(1.0, 0.0, 0.0)
   );

   results.hit[ray] = intersect_triangle(origins[ray], directions[ray]) ? 1u : 0u;
}
