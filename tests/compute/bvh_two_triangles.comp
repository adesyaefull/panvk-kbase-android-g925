#version 450

layout(local_size_x = 1) in;

struct BvhNode {
   vec4 bounds_min;
   vec4 bounds_max;
   uvec4 metadata;
};

layout(set = 0, binding = 0, std430) buffer BvhData {
   BvhNode nodes[3];
   vec4 vertices[6];
   uint hit[];
} data;

layout(push_constant) uniform Dispatch {
   uint mode;
} dispatch;

bool
intersect_bounds(vec3 origin, vec3 direction, BvhNode node)
{
   float near_t = 0.0;
   float far_t = 1e30;

   for (uint axis = 0; axis < 3; axis++) {
      if (abs(direction[axis]) < 1e-8) {
         if (origin[axis] < node.bounds_min[axis] ||
             origin[axis] > node.bounds_max[axis])
            return false;
      } else {
         float inverse_direction = 1.0 / direction[axis];
         float t0 = (node.bounds_min[axis] - origin[axis]) * inverse_direction;
         float t1 = (node.bounds_max[axis] - origin[axis]) * inverse_direction;
         near_t = max(near_t, min(t0, t1));
         far_t = min(far_t, max(t0, t1));
      }
   }

   return far_t >= near_t;
}

bool
intersect_triangle(vec3 origin, vec3 direction, uint primitive)
{
   uint vertex = primitive * 3;
   vec3 v0 = data.vertices[vertex + 0].xyz;
   vec3 e1 = data.vertices[vertex + 1].xyz - v0;
   vec3 e2 = data.vertices[vertex + 2].xyz - v0;
   const float epsilon = 1e-6;

   vec3 p = cross(direction, e2);
   float determinant = dot(e1, p);
   if (abs(determinant) < epsilon)
      return false;

   float inverse_determinant = 1.0 / determinant;
   vec3 t = origin - v0;
   float u = dot(t, p) * inverse_determinant;
   if (u < 0.0 || u > 1.0)
      return false;

   vec3 q = cross(t, e1);
   float v = dot(direction, q) * inverse_determinant;
   if (v < 0.0 || u + v > 1.0)
      return false;

   float distance = dot(e2, q) * inverse_determinant;
   return distance > epsilon;
}

void
build_leaf(uint node_index, uint primitive)
{
   uint vertex = primitive * 3;
   vec3 a = data.vertices[vertex + 0].xyz;
   vec3 b = data.vertices[vertex + 1].xyz;
   vec3 c = data.vertices[vertex + 2].xyz;
   data.nodes[node_index].bounds_min =
      vec4(min(a, min(b, c)), 0.0);
   data.nodes[node_index].bounds_max =
      vec4(max(a, max(b, c)), 0.0);
   data.nodes[node_index].metadata = uvec4(1, primitive, 0, 0);
}

void
main()
{
   uint invocation = gl_GlobalInvocationID.x;
   if (dispatch.mode == 0) {
      if (invocation != 0)
         return;

      build_leaf(1, 0);
      build_leaf(2, 1);
      data.nodes[0].bounds_min =
         min(data.nodes[1].bounds_min, data.nodes[2].bounds_min);
      data.nodes[0].bounds_max =
         max(data.nodes[1].bounds_max, data.nodes[2].bounds_max);
      data.nodes[0].metadata = uvec4(0, 1, 2, 0);
      return;
   }

   const vec3 origins[4] = vec3[](
      vec3(0.2, 0.2, -1.0),
      vec3(2.2, 0.2, -1.0),
      vec3(1.4, 0.2, -1.0),
      vec3(0.0, 0.0, -1.0)
   );
   const vec3 direction = vec3(0.0, 0.0, 1.0);

   bool hit = false;
   if (intersect_bounds(origins[invocation], direction, data.nodes[0])) {
      for (uint child = 0; child < 2; child++) {
         uint node_index = data.nodes[0].metadata[child + 1];
         BvhNode node = data.nodes[node_index];
         if (intersect_bounds(origins[invocation], direction, node) &&
             intersect_triangle(origins[invocation], direction,
                                node.metadata.y)) {
            hit = true;
            break;
         }
      }
   }

   data.hit[invocation] = hit ? 1u : 0u;
}
