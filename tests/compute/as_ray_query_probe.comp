#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT top_level_as;
layout(set = 0, binding = 1, std430) buffer Result {
   uvec4 candidate[6];
   uvec4 committed[6];
   uvec4 candidate_instance[6];
   uvec4 committed_instance[6];
   uvec4 candidate_object_origin[6];
   uvec4 candidate_object_direction[6];
   uvec4 committed_object_origin[6];
   uvec4 committed_object_direction[6];
   uvec4 ray_params[6];
   uvec4 candidate_object_to_world[24];
   uvec4 candidate_world_to_object[24];
   uvec4 committed_object_to_world[24];
   uvec4 committed_world_to_object[24];
} result_buffer;

void
main()
{
   uint ray = gl_GlobalInvocationID.x;
   vec3 ray_origin = vec3(2.6, 0.1, -1.0);
   float ray_tmin = 0.0;
   float ray_tmax = 100.0;
   uint ray_cull_mask = 0xffu;
   if (ray == 1u) {
      ray_origin.xy = vec2(5.0, 2.0);
   } else if (ray == 2u) {
      ray_tmin = 1.3;
   } else if (ray == 3u) {
      ray_tmax = 1.1;
   } else if (ray == 4u) {
      ray_cull_mask = 0x80u;
   }

   rayQueryEXT query;
   rayQueryInitializeEXT(query, top_level_as, gl_RayFlagsNoneEXT,
                         ray_cull_mask,
                         ray_origin, ray_tmin,
                         vec3(0.0, 0.0, 1.0), ray_tmax);
   bool has_candidate = false;
   while (rayQueryProceedEXT(query)) {
      has_candidate = true;
      uint candidate_type = rayQueryGetIntersectionTypeEXT(query, false);
      if (candidate_type == gl_RayQueryCandidateIntersectionTriangleEXT &&
          ray != 5u)
         rayQueryConfirmIntersectionEXT(query);
   }
   rayQueryTerminateEXT(query);

   mat4x3 candidate_object_to_world =
      rayQueryGetIntersectionObjectToWorldEXT(query, false);
   mat4x3 candidate_world_to_object =
      rayQueryGetIntersectionWorldToObjectEXT(query, false);
   mat4x3 committed_object_to_world =
      rayQueryGetIntersectionObjectToWorldEXT(query, true);
   mat4x3 committed_world_to_object =
      rayQueryGetIntersectionWorldToObjectEXT(query, true);
   uint committed_type = rayQueryGetIntersectionTypeEXT(query, true);
   uint committed_primitive =
      rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
   float committed_t = rayQueryGetIntersectionTEXT(query, true);
   vec2 committed_barycentrics =
      rayQueryGetIntersectionBarycentricsEXT(query, true);

   result_buffer.candidate[ray] = uvec4(0xffffffffu);
   result_buffer.candidate_instance[ray] = uvec4(0xffffffffu);
   result_buffer.candidate_object_origin[ray] = uvec4(0xffffffffu);
   result_buffer.candidate_object_direction[ray] = uvec4(0xffffffffu);
   if (has_candidate) {
      uint candidate_type = rayQueryGetIntersectionTypeEXT(query, false);
      uint candidate_primitive =
         rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
      float candidate_t = rayQueryGetIntersectionTEXT(query, false);
      vec2 candidate_barycentrics =
         rayQueryGetIntersectionBarycentricsEXT(query, false);
      uint candidate_instance_id =
         rayQueryGetIntersectionInstanceIdEXT(query, false);
      uint candidate_custom_index =
         rayQueryGetIntersectionInstanceCustomIndexEXT(query, false);
      uint candidate_sbt_index =
         rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT(
            query, false);
      vec3 candidate_object_origin =
         rayQueryGetIntersectionObjectRayOriginEXT(query, false);
      vec3 candidate_object_direction =
         rayQueryGetIntersectionObjectRayDirectionEXT(query, false);
      result_buffer.candidate[ray] =
         uvec4(candidate_type, candidate_primitive,
               floatBitsToUint(candidate_t),
               floatBitsToUint(candidate_barycentrics.x));
      result_buffer.candidate_instance[ray] =
         uvec4(candidate_instance_id, candidate_custom_index,
               candidate_sbt_index, 0u);
      result_buffer.candidate_object_origin[ray] =
         uvec4(floatBitsToUint(candidate_object_origin), 0u);
      result_buffer.candidate_object_direction[ray] =
         uvec4(floatBitsToUint(candidate_object_direction), 0u);
   }
   uint committed_instance_id =
      rayQueryGetIntersectionInstanceIdEXT(query, true);
   uint committed_custom_index =
      rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
   uint committed_sbt_index =
      rayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetEXT(query,
                                                                        true);
   vec3 committed_object_origin =
      rayQueryGetIntersectionObjectRayOriginEXT(query, true);
   vec3 committed_object_direction =
      rayQueryGetIntersectionObjectRayDirectionEXT(query, true);
   result_buffer.committed[ray] =
      uvec4(committed_type, committed_primitive, floatBitsToUint(committed_t),
            floatBitsToUint(committed_barycentrics.x));
   result_buffer.committed_instance[ray] =
      uvec4(committed_instance_id, committed_custom_index,
            committed_sbt_index, 0u);
   result_buffer.committed_object_origin[ray] =
      uvec4(floatBitsToUint(committed_object_origin), 0u);
   result_buffer.committed_object_direction[ray] =
      uvec4(floatBitsToUint(committed_object_direction), 0u);
   result_buffer.ray_params[ray] =
      uvec4(rayQueryGetRayFlagsEXT(query),
            floatBitsToUint(rayQueryGetRayTMinEXT(query)), 0u, 0u);
   for (uint column = 0; column < 4; column++) {
      result_buffer.candidate_object_to_world[ray * 4 + column] =
         has_candidate
            ? uvec4(floatBitsToUint(candidate_object_to_world[column]), 0u)
            : uvec4(0xffffffffu);
      result_buffer.candidate_world_to_object[ray * 4 + column] =
         has_candidate
            ? uvec4(floatBitsToUint(candidate_world_to_object[column]), 0u)
            : uvec4(0xffffffffu);
      result_buffer.committed_object_to_world[ray * 4 + column] =
         uvec4(floatBitsToUint(committed_object_to_world[column]), 0u);
      result_buffer.committed_world_to_object[ray * 4 + column] =
         uvec4(floatBitsToUint(committed_world_to_object[column]), 0u);
   }
}
