#version 450

layout(local_size_x = 1) in;

struct BvhNode {
   vec4 bounds_min;
   vec4 bounds_max;
   uvec4 metadata;
};

layout(set = 0, binding = 0, std430) buffer BvhData {
   BvhNode root;
   uint hit[];
} data;

layout(push_constant) uniform Dispatch {
   uint mode;
} dispatch;

bool
intersect_bounds(vec3 origin, vec3 direction, vec3 bounds_min, vec3 bounds_max)
{
   float near_t = 0.0;
   float far_t = 1e30;

   for (uint axis = 0; axis < 3; axis++) {
      if (abs(direction[axis]) < 1e-8) {
         if (origin[axis] < bounds_min[axis] ||
             origin[axis] > bounds_max[axis])
            return false;
      } else {
         float inverse_direction = 1.0 / direction[axis];
         float t0 = (bounds_min[axis] - origin[axis]) * inverse_direction;
         float t1 = (bounds_max[axis] - origin[axis]) * inverse_direction;
         near_t = max(near_t, min(t0, t1));
         far_t = min(far_t, max(t0, t1));
      }
   }

   return far_t >= near_t;
}

bool
intersect_triangle(vec3 origin, vec3 direction)
{
   const vec3 v0 = vec3(0.0, 0.0, 0.0);
   const vec3 e1 = vec3(1.0, 0.0, 0.0);
   const vec3 e2 = vec3(0.0, 1.0, 0.0);
   const float epsilon = 1e-6;

   vec3 p = cross(direction, e2);
   float determinant = dot(e1, p);
   if (abs(determinant) < epsilon)
      return false;

   float inverse_determinant = 1.0 / determinant;
   vec3 t = origin - v0;
   float u = dot(t, p) * inverse_determinant;
   if (u < 0.0 || u > 1.0)
      return false;

   vec3 q = cross(t, e1);
   float v = dot(direction, q) * inverse_determinant;
   if (v < 0.0 || u + v > 1.0)
      return false;

   float distance = dot(e2, q) * inverse_determinant;
   return distance > epsilon;
}

void
main()
{
   uint ray = gl_GlobalInvocationID.x;

   if (dispatch.mode == 0) {
      if (ray != 0)
         return;

      data.root.bounds_min = vec4(0.0, 0.0, 0.0, 0.0);
      data.root.bounds_max = vec4(1.0, 1.0, 0.0, 0.0);
      data.root.metadata = uvec4(1, 0, 0, 0);
      return;
   }

   vec3 origins[4] = vec3[](
      vec3(0.2, 0.2, -1.0),
      vec3(1.1, 1.1, -1.0),
      vec3(0.0, 0.0, -1.0),
      vec3(0.2, 0.2, -1.0)
   );
   vec3 directions[4] = vec3[](
      vec3(0.0, 0.0, 1.0),
      vec3(0.0, 0.0, 1.0),
      vec3(0.0, 0.0, 1.0),
      vec3(1.0, 0.0, 0.0)
   );

   bool hit_bounds = intersect_bounds(origins[ray], directions[ray],
                                      data.root.bounds_min.xyz,
                                      data.root.bounds_max.xyz);
   data.hit[ray] = hit_bounds &&
                   data.root.metadata.x == 1 &&
                   intersect_triangle(origins[ray], directions[ray]) ? 1u : 0u;
}
